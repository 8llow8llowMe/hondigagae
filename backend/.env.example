# ============================================================================
# 혼디가개 백엔드 환경변수 카탈로그
#
# dev/prod 프로파일이 참조하는 env 키 전체 목록이다.
# 실제 값은 Vault(kv/hondigagae/backend/{dev|prod}/env)에서 주입되며,
# 이 파일은 키 이름의 단일 기준점으로만 사용한다. 실제 시크릿은 절대 커밋하지 않는다.
# ============================================================================

# --- 공통 ---
SPRING_PROFILES_ACTIVE=dev
TIME_ZONE=Asia/Seoul

# --- 서비스 디스커버리 (Eureka) ---
SERVICE_DISCOVERY_PORT=6761
SERVICE_DISCOVERY_HOSTNAME=192.168.0.11

# --- 게이트웨이 ---
API_GATEWAY_PORT=6000

# --- 서비스 포트 (dev 6xxx / prod 9xxx) ---
BATCH_SERVICE_PORT=6080
AUTH_SERVICE_PORT=6081
TOUR_SERVICE_PORT=6082
PLAN_SERVICE_PORT=6083
AI_SERVICE_PORT=6085

# --- Eureka 등록명 (환경별 접미사가 붙으므로 게이트웨이/Feign이 이 값을 참조) ---
AUTH_SERVICE_APP_NAME=auth-service-dev
TOUR_SERVICE_APP_NAME=tour-service-dev
PLAN_SERVICE_APP_NAME=plan-service-dev
AI_SERVICE_APP_NAME=ai-service-dev

# --- DB (서비스별 스키마 분리) ---
DB_USERNAME=hondigagae
DB_PASSWORD=
AUTH_DB_URL=jdbc:mysql://192.168.0.11:3306/hondigagae_auth?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
TOUR_DB_URL=jdbc:mysql://192.168.0.11:3306/hondigagae_tour?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
PLAN_DB_URL=jdbc:mysql://192.168.0.11:3306/hondigagae_plan?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
BATCH_DB_URL=jdbc:mysql://192.168.0.11:3306/hondigagae_tour?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul

# --- Redis (standalone | sentinel) ---
REDIS_MODE=standalone
REDIS_HOST=192.168.0.11
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=hondigagae-dev

# --- JWT ---
# access-key 는 auth-service(발급) / api-gateway(검증) / tour·plan·ai-service(Resource Server)가
# 모두 같은 값을 써야 한다. HS512 라 64바이트 이상이어야 한다.
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=
JWT_ACCESS_EXPIRATION=PT1H
JWT_REFRESH_EXPIRATION=P14D
# 블랙리스트 조회 실패 시 정책 (false = fail-closed, 503 응답)
JWT_BLACKLIST_FAIL_OPEN=false

# --- Snowflake ID (서비스마다 다른 worker-id 를 준다) ---
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

# --- 소셜 로그인 (provider 추가 시 같은 형식으로 늘린다) ---
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_KAKAO_REDIRECT_URI=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=

# --- 일반 로그인 (이메일 인증코드 발송용 SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 로그인 실패 잠금 ---
AUTH_LOGIN_MAX_FAILURE_COUNT=5
AUTH_LOGIN_LOCK_DURATION=PT10M

# --- 오브젝트 스토리지 (MinIO) — 프로필 이미지 ---
# 백엔드와 다른 호스트에 있으므로 컨테이너명이 아니라 사설 IP 로 접속한다.
MINIO_ENDPOINT=http://192.168.0.12:9000
# 브라우저가 이미지를 조회할 공개 주소. DB 에는 key 만 저장하고 응답 시 이 값으로 URL 을 조립한다.
MINIO_PUBLIC_URL=
MINIO_BUCKET=hondigagae
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_MAX_FILE_BYTES=5242880

# --- 업로드 상한 ---
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=30MB

# --- 공공데이터 (한국관광공사 / 기상청 공용 인증키) ---
# 절대 커밋하지 않는다. batch-service 와 tour-service 가 사용한다.
TOUR_API_SERVICE_KEY=

# --- 카카오 로컬 (주변 식당·카페 실시간 검색) ---
# 카카오 개발자센터 REST API 키. 소셜 로그인 키(OAUTH_KAKAO_*)와는 다른 용도지만 같은 앱의 키다.
# 사용 전 콘솔에서 [내 애플리케이션 > 카카오맵] 활성화가 필요하다.
# 응답은 DB·캐시 어디에도 저장하지 않는다 (docs/place-data-integration.md 6절).
KAKAO_REST_API_KEY=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_CONNECT_TIMEOUT_MS=2000
KAKAO_LOCAL_READ_TIMEOUT_MS=3000

# --- VWorld 지오코더 (국토교통부, 주소 -> WGS84 좌표) ---
# vworld.kr 에서 발급. 식약처 반려동물 동반출입 음식점은 주소만 주므로 배치에서 좌표를 채운다.
# 일 40,000건 무료. batch-service 만 사용한다.
VWORLD_API_KEY=
VWORLD_BASE_URL=https://api.vworld.kr

# --- 내부 서비스 호출 타임아웃 ---
INTERNAL_CLIENT_CONNECT_TIMEOUT_MS=2000
INTERNAL_CLIENT_READ_TIMEOUT_MS=5000

# --- AI 작업 상태 보관 ---
AI_PLAN_JOB_TTL_SECONDS=86400
AI_PLAN_JOB_PENDING_TIMEOUT_SECONDS=30
AI_PLAN_JOB_RUNNING_TIMEOUT_SECONDS=300
