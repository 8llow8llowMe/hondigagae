# ============================================================================
# 혼디가개 백엔드 환경변수 카탈로그
#
# dev/prod 프로파일과 docker-compose-*.yml 이 참조하는 env 키 전체 목록이다.
# 실제 값은 Vault(kv/hondigagae/backend/{dev|prod}/env)에서 주입되며,
# 이 파일은 키 이름의 단일 기준점으로만 사용한다. 실제 시크릿은 절대 커밋하지 않는다.
#
# ▸ `<...>` 로 감싼 값은 자리표시자다. 비밀값과 호스트 주소는 이 파일에 적지 않는다 —
#   저장소가 공개되면 그대로 유출되기 때문이다. 실값은 Vault 에만 있다.
#
# ▸ Vault 에 넣을 때는 이 파일을 .env 로 복사해 `<...>` 를 채운 뒤 올린다. (.env 는 .gitignore 대상)
#   키별로 넣는다. 파일 전체를 env_file 한 키에 넣으면(env_file=@.env) 저장은 되지만 파이프라인이
#   줄바꿈 든 값을 거부해 배포 단계에서 실패한다. Web UI 의 JSON 토글에 {"KEY":"value"} 를 붙이거나:
#     vault kv put -mount="kv" hondigagae/backend/dev/env $(grep -Ev '^\s*(#|$)' .env | xargs)
#   Jenkins 는 이 secret 전체를 읽어 .env.runtime 을 만들고 `docker compose --env-file` 로 넘긴다.
#   애플리케이션이 .env 파일을 직접 읽지 않는다.
#
# ▸ 포트는 세 종류다. 헷갈리기 쉬우니 규칙을 먼저 읽는다.
#     {SVC}_PORT       컨테이너 **안에서** 앱이 듣는 포트. dev/prod 가 같다.
#     {SVC}_PORT_DEV   dev 호스트(main-server)에 노출할 포트. 7xxx 대역.
#     {SVC}_PORT_PROD  prod 호스트(backend-1)에 노출할 포트. 5xxx 대역.
#
#   compose 파일 하나에 dev/prod 서비스가 같이 정의되어 있고 `docker compose config` 가
#   양쪽을 모두 해석하므로, **dev secret 에도 _PROD 값을, prod secret 에도 _DEV 값을 넣는다.**
#   두 파일에 같은 포트표를 넣어 두면 된다. 실제로 기동하는 서비스는 파이프라인이 지정한 하나뿐이다.
#
#   7xxx / 5xxx 를 쓰는 이유: 같은 호스트에서 BossPickSeoul 이 dev 6xxx / prod 9xxx 를
#   이미 점유하고 있다. 둘 다 auth 가 6081 을 원해 그대로 두면 포트 바인딩이 실패한다.
#   (Infra README §4 배치 원칙 5번)
# ============================================================================

# --- 공통 ---
# dev secret 은 dev, prod secret 은 prod. 이 값이 어긋나면 운영이 dev 프로파일로 떠서
# ddl-auto:update 로 배포마다 운영 스키마가 자동 변경된다.
SPRING_PROFILES_ACTIVE=dev
TIME_ZONE=Asia/Seoul

# Jasypt ENC(...) 복호화 키. 파이프라인이 빌드 단계에서 존재를 강제한다.
# 지금은 ENC() 로 감싼 값이 없지만, 키가 비면 나중에 쓰기 시작하는 순간 조용히 깨진다.
JASYPT_ENCRYPTOR_KEY=<openssl rand -base64 32>

# --- 서비스 디스커버리 (Eureka) ---
# 컨테이너명을 쓴다. 사설 IP 가 아니다.
# 백엔드 7종이 같은 호스트의 8llow8llowme-net 브리지 안에 있어 컨테이너명으로 해석되고,
# 그래야 아래 SERVICE_DISCOVERY_PORT(컨테이너 내부 포트)와 짝이 맞는다.
#   dev = hondigagae-service-discovery-dev / prod = hondigagae-service-discovery-prod
SERVICE_DISCOVERY_HOSTNAME=hondigagae-service-discovery-dev
SERVICE_DISCOVERY_APP_NAME=service-discovery-dev
SERVICE_DISCOVERY_PORT=8761
SERVICE_DISCOVERY_PORT_DEV=7761
SERVICE_DISCOVERY_PORT_PROD=5761

# --- 게이트웨이 ---
API_GATEWAY_APP_NAME=api-gateway-dev
API_GATEWAY_PORT=8000
API_GATEWAY_PORT_DEV=7000
API_GATEWAY_PORT_PROD=5000

# --- 서비스 포트 ---
BATCH_SERVICE_PORT=8080
BATCH_SERVICE_PORT_DEV=7080
BATCH_SERVICE_PORT_PROD=5080
AUTH_SERVICE_PORT=8081
AUTH_SERVICE_PORT_DEV=7081
AUTH_SERVICE_PORT_PROD=5081
TOUR_SERVICE_PORT=8082
TOUR_SERVICE_PORT_DEV=7082
TOUR_SERVICE_PORT_PROD=5082
PLAN_SERVICE_PORT=8083
PLAN_SERVICE_PORT_DEV=7083
PLAN_SERVICE_PORT_PROD=5083
AI_SERVICE_PORT=8085
AI_SERVICE_PORT_DEV=7085
AI_SERVICE_PORT_PROD=5085

# --- Eureka 등록명 (환경별 접미사가 붙으므로 게이트웨이/내부 호출이 이 값을 참조) ---
# lb://{APP_NAME} 으로 라우팅되므로 각 서비스의 SPRING_APPLICATION_NAME 과 정확히 같아야 한다.
AUTH_SERVICE_APP_NAME=auth-service-dev
TOUR_SERVICE_APP_NAME=tour-service-dev
PLAN_SERVICE_APP_NAME=plan-service-dev
AI_SERVICE_APP_NAME=ai-service-dev
BATCH_SERVICE_APP_NAME=batch-service-dev

# --- 컨테이너 메모리 상한 (선택) ---
# 비우면 compose 기본값(dev 512m / prod 768m, discovery 는 384m / 512m)이 쓰인다.
# JVM heap 은 Dockerfile 의 MaxRAMPercentage=70 이 이 값을 기준으로 산정한다.
# prod 호스트(backend-1)는 available 6.4Gi 에 tripmarble·BossPickSeoul 이 함께 있어 빠듯하다.
# 여유가 없으면 서비스별로 낮춰 잡는다.
SERVICE_DISCOVERY_MEM_LIMIT_DEV=
SERVICE_DISCOVERY_MEM_LIMIT_PROD=
API_GATEWAY_MEM_LIMIT_DEV=
API_GATEWAY_MEM_LIMIT_PROD=
AUTH_SERVICE_MEM_LIMIT_DEV=
AUTH_SERVICE_MEM_LIMIT_PROD=
TOUR_SERVICE_MEM_LIMIT_DEV=
TOUR_SERVICE_MEM_LIMIT_PROD=
PLAN_SERVICE_MEM_LIMIT_DEV=
PLAN_SERVICE_MEM_LIMIT_PROD=
AI_SERVICE_MEM_LIMIT_DEV=
AI_SERVICE_MEM_LIMIT_PROD=
BATCH_SERVICE_MEM_LIMIT_DEV=
BATCH_SERVICE_MEM_LIMIT_PROD=

# --- DB (서비스별 스키마 분리) ---
# 백엔드 서비스마다 스키마를 따로 갖고, 스키마를 가로지르는 FK 는 두지 않는다(약한 결합).
# 다른 서비스의 행은 ID 값으로만 들고 있고 정합성은 애플리케이션이 책임진다.
# 스키마명은 BossPickSeoul 과 같은 규칙 `hondigagae_{service}_{env}` 다. dev 와 prod 가
# MySQL 호스트를 달리 쓰더라도 접미사를 붙여 두면 URL 만 보고 어느 환경인지 알 수 있다.
# 스키마·계정 생성 SQL 은 docs/deploy-guide.md "DB 스키마 준비" 절.
# ai-service · service-discovery · api-gateway 는 DB 를 쓰지 않는다.
# dev 는 ddl-auto:update 라 테이블은 첫 기동 때 자동 생성된다. 스키마와 계정만 미리 만든다.
DB_USERNAME=hondigagae
DB_PASSWORD=<DB 계정 비밀번호 — 스키마 준비 SQL 의 IDENTIFIED BY 와 같은 값>
AUTH_DB_URL=jdbc:mysql://<MySQL 호스트 사설 IP>:3306/hondigagae_auth_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
TOUR_DB_URL=jdbc:mysql://<MySQL 호스트 사설 IP>:3306/hondigagae_tour_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
PLAN_DB_URL=jdbc:mysql://<MySQL 호스트 사설 IP>:3306/hondigagae_plan_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true
# batch 는 tour 와 같은 스키마를 본다. 적재 대상이 tour 의 place 테이블이기 때문이다.
# Spring Batch 메타 테이블(BATCH_*)도 이 스키마에 생긴다 (dev 는 initialize-schema: always).
BATCH_DB_URL=jdbc:mysql://<MySQL 호스트 사설 IP>:3306/hondigagae_tour_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul&zeroDateTimeBehavior=convertToNull&rewriteBatchedStatements=true

# --- Redis (standalone | sentinel) ---
# BossPickSeoul 과 같은 Redis(main-server 의 redis-node1, 6379) 를 공유하므로 prefix 로 키 공간을 가른다.
# dev 는 BossPickSeoul dev 와 똑같이 standalone 으로 붙는다. sentinel 은 앱 배선(redis-core,
# yml, compose)까지 끝나 있으니 인프라 쪽 sentinel 구성이 확정되면 REDIS_MODE 와 아래 두 값만 바꿔 켠다.
REDIS_MODE=standalone
# standalone 에서만 쓰인다. sentinel 모드에서는 무시된다.
REDIS_HOST=<Redis 호스트 사설 IP>
REDIS_PORT=6379
# redis-node1 의 requirepass. BossPickSeoul dev secret 의 REDIS_PASSWORD 와 같은 값이다.
REDIS_PASSWORD=<Redis requirepass>
# sentinel 모드 필수. 둘 중 하나라도 비면 기동 시점에 실패한다(예전에는 NPE 로 죽었다).
# standalone 이면 비워 둔다. 노드는 host:port 콤마 구분, 포트를 생략하면 26379 로 본다.
#   예) REDIS_MASTER_NAME=master-redis
#       REDIS_SENTINEL_NODES=<sentinel1 IP>:26379,<sentinel2 IP>:26379,<sentinel3 IP>:26379
REDIS_MASTER_NAME=
REDIS_SENTINEL_NODES=
# BossPickSeoul(bosspickseoul:dev) 과 같은 `{project}:{env}` 꼴로 맞춘다.
REDIS_KEY_PREFIX=hondigagae:dev

# --- JWT ---
# access-key 는 auth-service(발급) / api-gateway(검증) / tour·plan·ai-service(Resource Server)가
# 모두 같은 값을 써야 한다. HS512 라 64바이트 이상이어야 한다.
#
# Resource Server 계열은 프로퍼티 prefix 가 app.security.jwt.resource.access-key 다.
# 이름이 auth-service 쪽(jwt.access-key)과 달라도 값은 같아야 하고, 어긋나면 기동은 되다가
# 첫 인증 요청에서 jwtDecoder NPE 로 죽는다.
JWT_ACCESS_KEY=<openssl rand -base64 64 | tr -d '\n' — 64바이트 이상, BossPickSeoul 과 다른 값>
JWT_REFRESH_KEY=<openssl rand -base64 64 | tr -d '\n' — access 와 다른 값>
JWT_ACCESS_EXPIRATION=PT1H
JWT_REFRESH_EXPIRATION=P14D
# 블랙리스트 조회 실패 시 정책 (false = fail-closed, 503 응답)
JWT_BLACKLIST_FAIL_OPEN=false

# --- Snowflake ID (서비스마다 다른 worker-id 를 준다) ---
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

# --- 소셜 로그인 (provider 추가 시 같은 형식으로 늘린다) ---
# 카카오는 로그인에만 쓴다. 지도는 클라이언트에서 JS SDK 로 그리고, 서버는 카카오 API 를 호출하지 않는다.
# REDIRECT_URI 는 카카오/네이버 콘솔에 등록한 값과 한 글자도 달라선 안 된다.
# 값은 **프론트**의 콜백 페이지다 (frontend/app/(auth)/oauth/[provider]/callback). 백엔드 주소가 아니다.
# 프론트가 code/state 를 받아 GET /auth/{provider}/login 을 부르는 2-step 흐름이라서다 (auth-guide §1).
#   dev  = https://dev.hondigagae.com/oauth/kakao/callback
#   prod = https://www.hondigagae.com/oauth/kakao/callback
OAUTH_KAKAO_CLIENT_ID=<카카오 앱 REST API 키>
OAUTH_KAKAO_CLIENT_SECRET=<카카오 앱 Client Secret>
OAUTH_KAKAO_REDIRECT_URI=https://<프론트 도메인>/oauth/kakao/callback
OAUTH_NAVER_CLIENT_ID=<네이버 앱 Client ID>
OAUTH_NAVER_CLIENT_SECRET=<네이버 앱 Client Secret>
OAUTH_NAVER_REDIRECT_URI=https://<프론트 도메인>/oauth/naver/callback

# --- 일반 로그인 (이메일 인증코드 발송용 SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<Gmail 계정 (@gmail.com 앞부분)>
MAIL_PASSWORD=<Gmail 앱 비밀번호 16자>

# --- 로그인 실패 잠금 ---
AUTH_LOGIN_MAX_FAILURE_COUNT=5
AUTH_LOGIN_LOCK_DURATION=PT10M

# --- 오브젝트 스토리지 (MinIO) — 프로필 이미지 ---
# 백엔드와 다른 호스트(storage)에 있으므로 컨테이너명이 아니라 사설 IP 로 접속한다.
MINIO_ENDPOINT=http://<MinIO 호스트 사설 IP>:9000
# 브라우저가 이미지를 조회할 공개 주소. DB 에는 key 만 저장하고 응답 시 이 값으로 URL 을 조립한다.
MINIO_PUBLIC_URL=https://<MinIO 공개 도메인>
MINIO_BUCKET=hondigagae
MINIO_ACCESS_KEY=<MinIO access key>
MINIO_SECRET_KEY=<MinIO secret key>
MINIO_MAX_FILE_BYTES=5242880

# --- 업로드 상한 ---
# nginx 의 client_max_body_size(30M) 와 맞춘다. 여기가 더 크면 nginx 가 먼저 413 을 던진다.
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=30MB

# --- 공공데이터: 한국관광공사 (batch-service) ---
# 공공데이터포털 "디코딩(원문)" 키. 절대 커밋하지 않는다.
TOUR_API_SERVICE_KEY=<data.go.kr 디코딩(원문) 키>
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011

# --- 공공데이터: 기상청 단기예보 (tour-service, 여행 적합도) ---
# 관광공사(B551011) 키와 같은 키를 쓸 수 있음이 실호출로 확인돼 있다.
# 비면 적합도(insight) 조회만 실패하고 나머지 API 는 정상 동작한다.
KMA_API_SERVICE_KEY=<data.go.kr 디코딩(원문) 키 — 관광공사 키 재사용 가능>
KMA_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_PUBLISH_DELAY_MINUTES=10
# 한 회차 전체 행 수. 실측 907~1052행이라 1000 으로는 잘린다(잘리면 마지막 날 최고기온이 낮게 나옴).
KMA_NUM_OF_ROWS=1500
KMA_STALE_CACHE_SECONDS=21600
# 중기예보 — 단기예보가 닿지 않는 날짜(대략 D+5 ~ D+10)를 덮는다. 같은 키를 쓴다.
# 발표가 1일 2회(06, 18시)라 회차 간격이 12시간이고, 스테일 허용도 그만큼 길게 잡는다.
KMA_MID_TERM_BASE_URL=https://apis.data.go.kr/1360000/MidFcstInfoService
KMA_MID_TERM_PUBLISH_DELAY_MINUTES=20
KMA_MID_TERM_STALE_CACHE_SECONDS=129600

# 쿼터 지렛대. 개발계정은 일 1,000건이고, 제주 육지를 덮는 격자 94개 x 발표 8회 = 752건이
# 최악값이라 마진이 25% 뿐이다. 쿼터가 빠듯해지면 아래 값으로 조인다.
#   cache-grace: 발표 후에도 이전 회차를 쓸 시간(분). 늘리면 호출이 준다
#   grid-coarsen-factor: 인접 격자 묶기. 2 로 올리면 호출이 대략 1/4 로 준다.
#     단 한라산과 해안이 한 격자로 뭉개져 고온 판정이 틀어진다 — 기본은 1(끔)
#   refresh-lock-seconds: 발표 직후 같은 격자 동시 호출을 막는 락 수명
KMA_CACHE_GRACE_MINUTES=30
KMA_MID_TERM_CACHE_GRACE_MINUTES=60
KMA_GRID_COARSEN_FACTOR=1
KMA_REFRESH_LOCK_SECONDS=10

# 기상특보 (WthrWrnInfoService). 단기·중기예보와 **별개로 활용신청**해야 한다.
# 2026-09-01: 신청 전에는 같은 키로도 SERVICE_KEY_IS_NOT_REGISTERED 였고, 신청 후 열렸다.
# 신청이 안 된 환경(새 계정 등)에서는 false 로 둔다 — 켜 두면 10분마다 실패 로그만 쌓인다.
KMA_WARNING_ENABLED=true
KMA_WARNING_BASE_URL=https://apis.data.go.kr/1360000/WthrWrnInfoService
KMA_WARNING_NUM_OF_ROWS=20
KMA_WARNING_CACHE_SECONDS=600
# 기상청 지점번호. 제주=184
KMA_WARNING_STATION_ID=184

# --- 여행 적합도 / 산책 위험도 임계값 (tour-service) ---
# 확정된 수의학 기준이 아니라 현재의 판단이므로, 재빌드 없이 Vault 값만 고쳐 조정할 수 있게 뺐다.
INSIGHT_RAIN_PROBABILITY_PERCENT=60
INSIGHT_HOT_TEMPERATURE=28.0
INSIGHT_VERY_HOT_TEMPERATURE=31.0
INSIGHT_COLD_TEMPERATURE=5.0
INSIGHT_VERY_COLD_TEMPERATURE=0.0
INSIGHT_STRONG_WIND_SPEED=9.0
INSIGHT_PAVEMENT_CAUTION_CELSIUS=42.0
INSIGHT_PAVEMENT_DANGER_CELSIUS=52.0
INSIGHT_HEAT_INDEX_CAUTION_CELSIUS=27.0
INSIGHT_HEAT_INDEX_DANGER_CELSIUS=32.0
INSIGHT_ALTERNATIVE_RADIUS_METERS=5000
INSIGHT_ALTERNATIVE_SIZE=5

# --- LLM: Spring AI / Ollama (ai-service, AI 여행 플래너) ---
# enabled=false 가 기본이다. LLM 없이도 기동되며 StubLlmAdapter 가 포트를 채운다 —
# 프론트 개발과 CI 가 로컬 LLM 기동 여부에 묶이면 안 되기 때문이다.
# 공유 인프라의 Ollama 는 ollama-01 호스트에 떠 있다 (Infra/ollama 참고).
# 모델 교체는 AI_LLM_MODEL 값 하나로 끝난다 (예: gpt-oss:20b, qwen2.5:7b-instruct, llama3.1:8b).
AI_LLM_ENABLED=false
AI_LLM_PROVIDER=OLLAMA
AI_LLM_BASE_URL=http://<Ollama 호스트 사설 IP>:11434
# Ollama 는 키가 없다. 키가 필요한 provider 를 붙일 때만 채운다.
AI_LLM_API_KEY=
AI_LLM_MODEL=gpt-oss:20b
# 모델 호출 read timeout(ms). 일정 생성은 리포트보다 출력이 길다.
AI_LLM_TIMEOUT_MS=120000
AI_LLM_MAX_TOKENS=4000
AI_LLM_TEMPERATURE=0.2
# gpt-oss 계열 추론 강도(low/medium/high). 기본 medium 은 추론에 토큰 대부분을 소모한다.
AI_LLM_REASONING_EFFORT=low
# 프롬프트에 싣는 후보 장소 수. 토큰 비용과 선택지 다양성의 절충이다.
AI_LLM_PLACE_CANDIDATE_SIZE=50

# --- VWorld 지오코더 (batch-service, 주소 -> WGS84 좌표) ---
# vworld.kr 에서 발급. 식약처 반려동물 동반출입 음식점은 주소만 주므로 배치에서 좌표를 채운다.
# 일 40,000건 무료. 비면 음식점이 좌표 없이 적재돼 반경 검색에 잡히지 않는다.
VWORLD_API_KEY=<vworld.kr 인증키>
VWORLD_BASE_URL=https://api.vworld.kr

# --- 식약처 반려동물 동반출입 음식점 (batch-service) ---
# 인증키가 없다. 비우면 원천에서 xlsx 를 직접 내려받는다.
MFDS_PET_RESTAURANT_FILE_PATH=

# --- 배치 데이터 디렉터리 (batch-service) ---
# 문화정보원 CSV(pet_culture.csv, 30MB)는 .gitignore 대상이라 저장소에 없다.
# 배포 호스트에 한 번 내려받아 두고(data.go.kr/data/15111389) 그 디렉터리를 여기 적는다.
# compose 가 이 경로를 /app/data 에 읽기 전용으로 붙인다. 비면 배포가 중단된다.
#
# ⚠️ **호스트 경로**다. deploy agent 컨테이너 안의 경로($HOME=/home/jenkins/...)가 아니다.
#    compose 는 agent 컨테이너 안에서 돌지만 바인드 마운트는 호스트의 docker 데몬이 해석한다.
#    배포 호스트 로그인 계정의 홈 아래에 둔다. 배포 전에 호스트에서 `mkdir -p` 로 만들고
#    CSV 를 넣어 둔다. 존재하지 않는 경로를 적으면 docker 가 빈 디렉터리를 root 소유로
#    만들어 버려서 잡이 CULTURE_CSV_NOT_FOUND 로만 실패한다.
BATCH_DATA_DIR=/home/<배포 호스트 계정>/deploy/hondigagae/backend/data
CULTURE_FACILITY_CSV_PATH=/app/data/pet_culture.csv

# --- 내부 서비스 호출 타임아웃 ---
INTERNAL_CLIENT_CONNECT_TIMEOUT_MS=2000
INTERNAL_CLIENT_READ_TIMEOUT_MS=5000

# --- AI 작업 상태 보관 ---
AI_PLAN_JOB_TTL_SECONDS=86400
AI_PLAN_JOB_PENDING_TIMEOUT_SECONDS=30
AI_PLAN_JOB_RUNNING_TIMEOUT_SECONDS=300
