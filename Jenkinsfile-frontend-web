// 혼디가개 프론트 웹(Next.js SSR) 배포 잡.
//
// Jenkins 멀티브랜치 파이프라인 이름: hondigagae-frontend-web
// 배포 대상 PR 라벨:                  frontend-web
//   dev  -> main-server (192.168.0.11), 호스트 포트 7300, https://dev.hondigagae.com
//   prod -> backend-1   (192.168.0.13), 호스트 포트 5300, https://www.hondigagae.com
//
// 파이프라인 단계는 Jenkinsfile.frontend-common.groovy 에 있다.
//   PR      -> pnpm install --frozen-lockfile / format:check / lint / typecheck / test / build
//   머지 후 -> 위 + standalone 번들 tar -> 배포 에이전트에서 compose up -> SSR 응답 확인
//
// GitHub Actions 의 frontend-ci.yml 과 검사 항목이 같다. 역할이 다르다 —
// Actions 는 모든 PR 의 빠른 게이트, 이 잡은 **배포까지 가는 경로**를 같은 검사로 한 번 더 확인한다.
def frontendPipeline
node('builder-frontend') {
    checkout scm
    frontendPipeline = load 'Jenkinsfile.frontend-common.groovy'
}

frontendPipeline.run([
    serviceName        : 'web',
    fsPath             : 'frontend',
    dockerfile         : 'frontend-web.Dockerfile',
    composeFile        : 'docker-compose-frontend-web.yml',
    composeServiceName : 'frontend-web',
    containerNamePrefix: 'hondigagae-frontend-web',
    deploySubdir       : 'web',
    bundleFile         : 'frontend-web-bundle.tar.gz',
    buildAgentLabel    : 'builder-frontend',
    deployAgentLabels  : [
        dev : 'deploy-frontend-dev',
        prod: 'deploy-frontend-prod'
    ],
    // 빌드 단계에서 반드시 있어야 하는 값입니다. 셋 다 `pnpm build` 를 직접 깨뜨립니다.
    //
    //   NEXT_PUBLIC_KAKAO_MAP_KEY  빌드 시점에 번들로 인라인됩니다. 비면 지도가 뜨지 않는
    //                              번들이 그대로 배포됩니다. src/lib/env.client.ts 가 zod
    //                              min(1) 로 잡아 빌드를 실패시킵니다.
    //   BACKEND_BASE_URL           NEXT_PUBLIC_ 이 아닌데도 빌드에 필요합니다.
    //   SESSION_SECRET             src/lib/env.server.ts 가 모듈 로드 시점에 zod 로
    //                              fail-fast 하기 때문입니다(url / min(32)).
    //                              .github/workflows/frontend-ci.yml 이 placeholder 를
    //                              넘기는 것도 같은 이유입니다.
    //
    // 카카오는 지도 SDK 와 로그인 SDK 가 같은 JavaScript 키 하나를 씁니다. 키를 나누지 마세요.
    // (WebSocket 은 아직 쓰지 않아 NEXT_PUBLIC_WS_URL 이 없습니다.
    //  실시간 기능이 붙으면 여기와 Vault 에 같이 추가합니다)
    requiredBuildEnvKeys : [
        'NEXT_PUBLIC_KAKAO_MAP_KEY',
        'BACKEND_BASE_URL',
        'SESSION_SECRET'
    ],
    // 컨테이너 기동에 필요한 런타임 값입니다. compose 가 참조하는 보간 변수 전체와 일치해야 합니다.
    // compose 에 기본값(`:-`)을 두지 않으므로, 하나라도 비면 배포 전에 여기서 막힙니다.
    // 포트와 메모리 상한은 환경 접미사가 없습니다. 환경별 .env.runtime 이 따로 만들어지므로
    // 접미사로 구분할 필요가 없고, 접미사를 붙이면 배포하지 않는 쪽 값까지 Vault 에 넣어야 합니다.
    // ('{ENV}' 를 쓰면 DEV/PROD 로 치환됩니다. 지금 쓰는 키는 없지만 규칙은 남겨둡니다)
    requiredRuntimeEnvKeys: [
        'TIME_ZONE',
        'SESSION_SECRET',
        'BACKEND_BASE_URL',
        'SITE_BASE_URL',
        'FRONTEND_WEB_PORT',
        'FRONTEND_WEB_MEM_LIMIT'
    ]
])
