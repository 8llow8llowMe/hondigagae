# ============================================================================
# 혼디가개 프론트 환경변수
#
# 로컬은 이 파일을 .env.local 로 복사해 `<...>` 자리표시자를 채워 쓴다.
# 비밀값은 이 파일에 적지 않는다 — 저장소가 공개되면 그대로 유출된다. 실값은 .env.local 과 Vault 에만 둔다.
# 배포 값은 Vault(kv/hondigagae/frontend/{dev|prod}/env)에서 주입되며,
# 이 파일이 키 이름의 단일 기준점이다. 실제 값은 커밋하지 않는다.
#
# ▸ 키 이름은 BossPickSeoul(kv/bosspickseoul/frontend/{env}/env) 과 **같다.**
#   두 프로젝트의 Vault 를 나란히 관리하므로 이름을 갈라 두지 않는다. 차이는 NEXT_PUBLIC_WS_URL 이
#   없다는 것 하나다 (WebSocket 을 아직 쓰지 않는다).
#
# ▸ 주입 시점이 둘로 나뉜다.
#     NEXT_PUBLIC_*  빌드 시점에 코드로 인라인된다. 컨테이너 환경변수로 넣어도 무시된다.
#                    그래서 dev 와 prod 는 같은 커밋이라도 각각 빌드한다.
#     그 외           서버에서만 읽는다. 배포 단계에서 .env.runtime 으로 compose 에 넘어간다.
#
#   단, BACKEND_API_URL 과 AUTH_SESSION_SECRET 은 **빌드에도 있어야 한다.**
#   src/lib/env.server.ts 가 모듈 로드 시점에 zod 로 fail-fast 하기 때문에
#   값이 없으면 `pnpm build` 가 실패한다. (.github/workflows/frontend-ci.yml 도 같은 이유로 넘긴다)
#   파이프라인은 Vault secret 전체를 빌드 단계에 주입하므로 따로 신경 쓸 것은 없다.
# ============================================================================

# --- 애플리케이션 ---
# 백엔드 게이트웨이 — BFF(Next 서버)만 사용한다. NEXT_PUBLIC_ 을 붙이지 않는다.
#
# 배포에서는 사설 IP 가 아니라 공개 도메인을 쓴다. dev 프론트와 dev 게이트웨이가 같은 호스트에
# 있어 http://<dev 호스트 사설 IP>:7000 으로 질러도 될 것 같지만, auth API(/api/v1/auth, /api/v1/members)는
# 게이트웨이를 거치지 않고 auth-service 로 직결되며 그 분기를 nginx 가 한다.
#   local = http://localhost:8000
#   dev   = https://api-dev.hondigagae.com
#   prod  = https://api.hondigagae.com
BACKEND_API_URL=http://localhost:8000

# 서버 세션 암호화 키 (32자 이상). 커밋 금지. `openssl rand -base64 48` 로 만든다.
#
# ⚠️ 환경당 한 번만 만들고 고정한다. 배포마다 새로 만들면 안 된다.
#    바뀌는 순간 기존 세션 쿠키를 복호화할 수 없어 로그인한 사용자가 전원 로그아웃된다.
#    dev 와 prod 는 서로 다른 값을 쓴다.
AUTH_SESSION_SECRET=<openssl rand -base64 48 로 만든 32자 이상 문자열>

# 카카오 지도 JavaScript 앱 키 — 클라이언트 번들에 노출된다.
# 카카오 개발자 콘솔에 도메인 등록이 전제다.
#   local = http://localhost:3000
#   dev   = https://dev.hondigagae.com
#   prod  = https://www.hondigagae.com
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=<카카오 앱 JavaScript 키>


# 배포 도메인 — og:image 절대 URL 과 canonical 에 쓴다 (app/layout.tsx metadataBase).
# 메타데이터는 서버에서만 만들어지지만 비밀이 아니고 BossPickSeoul 과 키 이름을 맞추기 위해
# NEXT_PUBLIC_ 접두사를 쓴다. 빌드 시점에 인라인되므로 컨테이너 환경변수로 넣어도 무시된다.
# 로컬은 비워도 된다(http://localhost:3000 으로 떨어진다). **배포에서는 필수**다 —
# 파이프라인의 빌드 단계 필수 키 검사(requiredBuildEnvKeys)가 없으면 빌드를 중단한다.
#   dev  = https://dev.hondigagae.com
#   prod = https://www.hondigagae.com
NEXT_PUBLIC_SITE_URL=

# 홈 판정의 대표 지점 (선택). 비우면 상수를 쓴다 — 126454(사라봉공원).
# 최근 본 장소도 일정도 없는 첫 방문자의 `오늘 산책 {등급}` 을 이 장소로 그린다
# (src/lib/insight/basis-place.ts · docs/features/home/홈-첫방문-판정-세부명세.md D3-2).
# placeId 는 TourAPI contentId 축이라 dev·운영이 같지만, 운영 DB 에서 이 장소가 내려가면
# 판정이 통째로 빠진다(404 → 미렌더). 그때 코드를 고치지 않고 여기서 갈아 끼운다.
# NEXT_PUBLIC_ 이라 빌드 시점에 인라인된다 — 바꾸면 재빌드가 필요하다.
NEXT_PUBLIC_DEFAULT_BASIS_PLACE_ID=

# 개발용 mock 응답 (선택). true 면 BFF·서버 프리페치가 게이트웨이 대신 fixture 를 돌려준다.
# 백엔드가 로컬에 뜨지 않은 상태에서 화면을 확인할 때만 쓴다.
# **프로덕션 빌드에서는 이 값과 무관하게 항상 비활성이다.**
# 구현: src/lib/api/mock/ — 계약 근거는 backend PlaceWebController / PlaceItem
#
# 배포용 Vault secret 에는 넣지 않는다. compose 가 NODE_ENV=production 으로 띄운다.
MOCK_API=false

# ============================================================================
# 아래는 배포에서만 쓰는 키다. 로컬(.env.local)에는 필요 없다.
# Vault kv/hondigagae/frontend/{dev|prod}/env 에는 반드시 들어가야 한다 —
# 없으면 파이프라인의 Runtime env key check 에서 배포가 중단된다.
# ============================================================================

# 컨테이너 타임존.
TIME_ZONE=Asia/Seoul

# 호스트 포트. dev 7300 / prod 5300.
# 환경 접미사가 없다 — 환경별 .env.runtime 이 따로 만들어지므로 각 secret 에 값 하나만 넣는다.
FRONTEND_WEB_PORT=7300

# 컨테이너 메모리 상한. dev 512m / prod 768m.
# compose 의 --max-old-space-size 가 이 값의 70~75% 로 잡혀 있으니
# 여기를 바꾸면 docker-compose-frontend-web.yml 의 command 도 함께 조정한다.
FRONTEND_WEB_MEM_LIMIT=512m
